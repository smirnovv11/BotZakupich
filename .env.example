# Telegram
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# Northflank can use BOT_TOKEN instead of TELEGRAM_BOT_TOKEN.
# BOT_TOKEN=replace-with-telegram-bot-token

# Database
DATABASE_URL=postgresql+asyncpg://shopping_user:shopping_password@localhost:5432/shopping_bot

# Application
ENVIRONMENT=local
LOG_LEVEL=INFO
PARSER_VERSION=local-v1
RUN_MIGRATIONS=false
